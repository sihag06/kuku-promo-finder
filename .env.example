# Copy to .env (same folder) and fill in ANY ONE or more. .env is gitignored.
# With preset: auto the tool uses whichever key is present (OpenAI > Anthropic > Gemini);
# with two vendors' keys, the gold set is built by the other vendor.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Only for preset: compatible servers that need a key (OpenRouter, Groq, ...)
COMPATIBLE_API_KEY=
